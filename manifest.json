{
  "manifest_version": 3,
  "name": "eva-buddy",
  "version": "1.6.0",
  "description": "EVA admin quality-of-life: env color stripe, dark mode, module switcher, hover-QR, JSON/API tools, and order & consumer helpers.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "eva-buddy"
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer.html", "viewer.css", "viewer.js", "pos-logo.png"],
      "matches": [
        "*://*.test.eva-online.cloud/*",
        "*://*.acc.eva-online.cloud/*",
        "*://*.prod.eva-online.cloud/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.test.eva-online.cloud/*",
        "*://*.acc.eva-online.cloud/*",
        "*://*.prod.eva-online.cloud/*"
      ],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.test.eva-online.cloud/*",
        "*://*.acc.eva-online.cloud/*",
        "*://*.prod.eva-online.cloud/*"
      ],
      "js": ["qrcode.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
